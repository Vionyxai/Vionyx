{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/apply", "destination": "/apply/index.html" },
    { "source": "/auth/confirm", "destination": "/auth/confirm/index.html" },
    { "source": "/auth/reset", "destination": "/auth/reset/index.html" },
    { "source": "/legal/privacy", "destination": "/legal/privacy/index.html" },
    { "source": "/legal/terms", "destination": "/legal/terms/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
